# Server Configuration
PORT=3000
NODE_ENV=production
SITE_URL=https://www.loukaengg.com

# Admin Authentication
# REQUIRED IN PRODUCTION: Set ADMIN_PASSWORD or ADMIN_PASSWORD_HASH (bcrypt hash recommended)
# Generate bcrypt hash: node -e "console.log(require('bcryptjs').hashSync('yourpassword', 12))"
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_LIFETIME=1500
SESSION_SECRET=generate-a-secure-random-secret-here
IP_HASH_SALT=generate-a-random-salt-for-ip-anonymization

# Business Info & Notifications
NOTIFY_EMAIL=edward@loukaengg.com
REVIEWS_PER_PAGE=6
# Louka Engineering WhatsApp: +91 86675 56619
WHATSAPP_NUMBER=918667556619
PUBLISH_IMMEDIATELY=true
RATE_LIMIT_HOURS=24

# SMTP Email Transport (Required for live email delivery)
# Option A: GoDaddy cPanel internal mail relay (recommended on GoDaddy Shared Hosting - no credentials needed):
# SMTP_HOST=relay-hosting.secureserver.net
# SMTP_PORT=25
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
#
# Option B: Standard Authenticated SMTP (e.g. Google Workspace, Brevo, AWS SES):
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=your-smtp-password
SMTP_SECURE=false
FROM_EMAIL=noreply@loukaengg.com

# SMS Gateway Integration ('twilio' | 'fast2sms' | 'console')
SMS_PROVIDER=console
# If using Twilio:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# If using Fast2SMS:
FAST2SMS_API_KEY=
